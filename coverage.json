{
  "schema": 1,
  "updatedAt": "2026-09-22",
  "note": "能力面清单（机器可读）——本文件是「应该覆盖什么」的唯一权威声明。tests/audit_capability.py 拿它与实现、文档三方对账，缺口与状态全部实测得出，不手工维护数字。改能力面就改这里，不要改文档里的数字。",
  "howto": {
    "probe.kind": {
      "core_len": "调用 core.<call>() 取其长度（如 pinmap_list）",
      "core_has": "names 里有几个真存在于 core（用于判断某个工具/函数是否已实现）",
      "layer_dirs": "层叠列举数据目录下的子目录个数（内置层 + 外置补充层）",
      "layer_files": "层叠列举数据目录下的文件个数",
      "errcode_entries": "全部错误码表的条目总数",
      "rules": "analyzer 内置规则 + 外置规则条数",
      "attr_len": "模块级容器属性的长度（如 core._FLASH_TOOLS）",
      "decorators": "server.py 里某类装饰器的个数（tool/resource/prompt）",
      "file_exists": "paths 里有几个真实存在（用于工程交付物）",
      "axes_met": "ids 里已达标的能力轴个数（用于「多轴合并」型缺口）",
      "tools_with_assertions": "有专项断言的工具个数（复用深度矩阵，反着看就是 N-14）",
      "manual": "无法自动数，须在 reason 里说明原因并给 now——这是最后手段，能自动就别用"
    },
    "gap.done": "now >= target 即视为该缺口已完成"
  },
