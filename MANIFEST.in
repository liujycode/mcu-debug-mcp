# sdist 必须包含的非 .py 资产
# ★ 为什么需要这个文件（2026-10-13 实测复现的 P0）：
#   `python -m build` 的标准流程是「先打 sdist → 解包 → 再构 wheel」，
#   sdist 里没有数据目录时 wheel 会跟着变空壳。MANIFEST.in 是 sdist 的
#   唯一收录清单，漏一行就复发一次。
# 2026-10-13 C 档重构后数据目录物理位于 src/mcu_debug_mcp/ 下，
# wheel 侧由 include-package-data=true 接管（同一份清单两处生效）。
include README.md
include LICENSE
include SECURITY.md
include CHANGELOG.md
include ROADMAP.md
include PLAN.md
include requirements.txt
recursive-include src/mcu_debug_mcp/knowledge *.json *.md
recursive-include src/mcu_debug_mcp/drivers *.c *.h *.json *.md
prune src/mcu_debug_mcp/drivers/**/build
prune src/mcu_debug_mcp/drivers/**/*.bin
prune src/mcu_debug_mcp/drivers/**/*.elf
prune src/mcu_debug_mcp/drivers/**/*.map
recursive-include src/mcu_debug_mcp/tools *.py *.c *.h *.ld *.md
prune src/mcu_debug_mcp/tools/**/build
prune src/mcu_debug_mcp/tools/**/*.bin
prune src/mcu_debug_mcp/tools/**/*.elf
prune src/mcu_debug_mcp/tools/**/*.map
recursive-include docs *.md
recursive-include tests *.py
recursive-include examples *.py
recursive-include .github *.yml *.yaml
include pyproject.toml setup.py
global-exclude __pycache__ *.pyc *.pyo
